# Recorded gameplay trajectories (your data — keep local unless you choose to commit)
/data/*.jsonl
/data/*.jsonl.partial

# Scheduled log-collection output (logs/*.log captures themselves ARE committed)
/logs/collect.log

# Fetched VOD transcripts/metadata (other people's content — keep local)
/data/vods/

# HSReplay capture tooling: browser profile holds your LOGIN SESSION (never
# commit), raw captures are bulky premium data (normalized stats ARE committed)
/data/stats/hsreplay_profile/
/data/stats/hsreplay_captures/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Node (Firestone sim bridge)
bridge/node_modules/
bridge/package-lock.json

# ML model weights / artifacts
*.pt
*.pth

# OS
.DS_Store
*.pt.meta.json

# HearthstoneJSON dbf-id index (auto-downloaded cache, regenerable)
/data/cards/hsjson_index.json
